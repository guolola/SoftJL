{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": [
        "./src/shared/ui/utils.ts"
      ],
      "@/components/ui/*": [
        "./src/shared/ui/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./tests/*"
      ]
    },
    "allowJs": true,
    "strict": false,
    "incremental": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noUnusedLocals": true
  },
  "include": [
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "src/assets/data"
  ],
  "extends": "../../tsconfig.base.json"
}
