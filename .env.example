# Root development settings, loaded by npm run dev. Copy to .env and keep real values private.
# Leave DATABASE_URL unset for temporary in-memory accounts, projects and task history.
# npm run dev:postgres provisions a persistent local development database automatically.
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE
API_PORT=4101
RENDER_SERVICE_PORT=4002

# Keep a stable private encryption key when persisting provider credentials.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# UML_PROVIDER_CONFIG_SECRET=

# Optional public origin and SMTP settings; see docs/deployment/production-environment.md.
# PUBLIC_WEB_BASE_URL=https://community.example.test
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
